package lemon.lexer;

class TokenKind {
    public static int Class = 0;
    public static int Interface = 1;
    public static int Extends = 2;
    public static int Implements = 3;
    public static int Abstract = 4;
    public static int Virtual = 5;
    public static int Override = 6;
    public static int Final = 7;
    public static int Static = 8;
    public static int Public = 9;
    public static int Private = 10;
    public static int Reflectable = 11;
    public static int New = 12;
    public static int Delete = 13;
    public static int Null = 14;
    public static int True = 15;
    public static int False = 16;
    public static int If = 17;
    public static int Else = 18;
    public static int For = 19;
    public static int While = 20;
    public static int Return = 21;
    public static int Break = 22;
    public static int Continue = 23;
    public static int Try = 24;
    public static int Catch = 25;
    public static int Throw = 26;
    public static int Import = 27;
    public static int Package = 28;
    public static int Extern = 29;
    public static int Sizeof = 30;
    public static int TypeId = 31;
    public static int This = 32;
    public static int Super = 33;
    public static int InstanceOf = 34;
    public static int At = 35;
    public static int As = 36;
    public static int Finally = 37;
    public static int Enum = 38;
    public static int Match = 39;
    public static int Switch = 40;
    public static int Case = 41;
    public static int Default = 42;
    public static int In = 43;
    public static int Void = 44;
    public static int Bool = 45;
    public static int Byte = 46;
    public static int Char = 47;
    public static int Short = 48;
    public static int Int = 49;
    public static int Long = 50;
    public static int Float = 51;
    public static int Double = 52;
    public static int Identifier = 53;
    public static int IntegerLiteral = 54;
    public static int FloatLiteral = 55;
    public static int StringLiteral = 56;
    public static int CharLiteral = 57;
    public static int Plus = 58;
    public static int Minus = 59;
    public static int Star = 60;
    public static int Slash = 61;
    public static int Percent = 62;
    public static int Amp = 63;
    public static int Pipe = 64;
    public static int Caret = 65;
    public static int Tilde = 66;
    public static int Lt = 67;
    public static int Gt = 68;
    public static int Le = 69;
    public static int Ge = 70;
    public static int Eq = 71;
    public static int Ne = 72;
    public static int And = 73;
    public static int Or = 74;
    public static int Not = 75;
    public static int Assign = 76;
    public static int PlusAssign = 77;
    public static int MinusAssign = 78;
    public static int StarAssign = 79;
    public static int SlashAssign = 80;
    public static int PercentAssign = 81;
    public static int AndAssign = 82;
    public static int OrAssign = 83;
    public static int XorAssign = 84;
    public static int Shl = 85;
    public static int Shr = 86;
    public static int ShlAssign = 87;
    public static int ShrAssign = 88;
    public static int Inc = 89;
    public static int Dec = 90;
    public static int Arrow = 91;
    public static int FatArrow = 92;
    public static int LeftParen = 93;
    public static int RightParen = 94;
    public static int LeftBrace = 95;
    public static int RightBrace = 96;
    public static int LeftBracket = 97;
    public static int RightBracket = 98;
    public static int Comma = 99;
    public static int Dot = 100;
    public static int Semicolon = 101;
    public static int Colon = 102;
    public static int Question = 103;
    public static int NullCoalesce = 106;
    public static int EndOfFile = 104;
    public static int Error = 105;

    public static String toString(int kind) {
        if (kind == TokenKind.Class) return "class";
        if (kind == TokenKind.Interface) return "interface";
        if (kind == TokenKind.Extends) return "extends";
        if (kind == TokenKind.Implements) return "implements";
        if (kind == TokenKind.Abstract) return "abstract";
        if (kind == TokenKind.Virtual) return "virtual";
        if (kind == TokenKind.Override) return "override";
        if (kind == TokenKind.Final) return "final";
        if (kind == TokenKind.Static) return "static";
        if (kind == TokenKind.Public) return "public";
        if (kind == TokenKind.Private) return "private";
        if (kind == TokenKind.Reflectable) return "reflectable";
        if (kind == TokenKind.New) return "new";
        if (kind == TokenKind.Delete) return "delete";
        if (kind == TokenKind.Null) return "null";
        if (kind == TokenKind.True) return "true";
        if (kind == TokenKind.False) return "false";
        if (kind == TokenKind.If) return "if";
        if (kind == TokenKind.Else) return "else";
        if (kind == TokenKind.For) return "for";
        if (kind == TokenKind.While) return "while";
        if (kind == TokenKind.Return) return "return";
        if (kind == TokenKind.Break) return "break";
        if (kind == TokenKind.Continue) return "continue";
        if (kind == TokenKind.Try) return "try";
        if (kind == TokenKind.Catch) return "catch";
        if (kind == TokenKind.Throw) return "throw";
        if (kind == TokenKind.Import) return "import";
        if (kind == TokenKind.Package) return "package";
        if (kind == TokenKind.Extern) return "extern";
        if (kind == TokenKind.Sizeof) return "sizeof";
        if (kind == TokenKind.TypeId) return "typeid";
        if (kind == TokenKind.This) return "this";
        if (kind == TokenKind.Super) return "super";
        if (kind == TokenKind.InstanceOf) return "instanceof";
        if (kind == TokenKind.At) return "@";
        if (kind == TokenKind.As) return "as";
        if (kind == TokenKind.Finally) return "finally";
        if (kind == TokenKind.Enum) return "enum";
        if (kind == TokenKind.Match) return "match";
        if (kind == TokenKind.Switch) return "switch";
        if (kind == TokenKind.Case) return "case";
        if (kind == TokenKind.Default) return "default";
        if (kind == TokenKind.In) return "in";
        if (kind == TokenKind.Void) return "void";
        if (kind == TokenKind.Bool) return "bool";
        if (kind == TokenKind.Byte) return "byte";
        if (kind == TokenKind.Char) return "char";
        if (kind == TokenKind.Short) return "short";
        if (kind == TokenKind.Int) return "int";
        if (kind == TokenKind.Long) return "long";
        if (kind == TokenKind.Float) return "float";
        if (kind == TokenKind.Double) return "double";
        if (kind == TokenKind.Identifier) return "Identifier";
        if (kind == TokenKind.IntegerLiteral) return "Int";
        if (kind == TokenKind.FloatLiteral) return "Float";
        if (kind == TokenKind.StringLiteral) return "String";
        if (kind == TokenKind.CharLiteral) return "Char";
        if (kind == TokenKind.Plus) return "+";
        if (kind == TokenKind.Minus) return "-";
        if (kind == TokenKind.Star) return "*";
        if (kind == TokenKind.Slash) return "/";
        if (kind == TokenKind.Percent) return "%";
        if (kind == TokenKind.Amp) return "&";
        if (kind == TokenKind.Pipe) return "|";
        if (kind == TokenKind.Caret) return "^";
        if (kind == TokenKind.Tilde) return "~";
        if (kind == TokenKind.Lt) return "<";
        if (kind == TokenKind.Gt) return ">";
        if (kind == TokenKind.Le) return "<=";
        if (kind == TokenKind.Ge) return ">=";
        if (kind == TokenKind.Eq) return "==";
        if (kind == TokenKind.Ne) return "!=";
        if (kind == TokenKind.And) return "&&";
        if (kind == TokenKind.Or) return "||";
        if (kind == TokenKind.Not) return "!";
        if (kind == TokenKind.Assign) return "=";
        if (kind == TokenKind.PlusAssign) return "+=";
        if (kind == TokenKind.MinusAssign) return "-=";
        if (kind == TokenKind.StarAssign) return "*=";
        if (kind == TokenKind.SlashAssign) return "/=";
        if (kind == TokenKind.PercentAssign) return "%=";
        if (kind == TokenKind.AndAssign) return "&=";
        if (kind == TokenKind.OrAssign) return "|=";
        if (kind == TokenKind.XorAssign) return "^=";
        if (kind == TokenKind.Shl) return "<<";
        if (kind == TokenKind.Shr) return ">>";
        if (kind == TokenKind.ShlAssign) return "<<=";
        if (kind == TokenKind.ShrAssign) return ">>=";
        if (kind == TokenKind.Inc) return "++";
        if (kind == TokenKind.Dec) return "--";
        if (kind == TokenKind.Arrow) return "->";
        if (kind == TokenKind.FatArrow) return "=>";
        if (kind == TokenKind.LeftParen) return "(";
        if (kind == TokenKind.RightParen) return ")";
        if (kind == TokenKind.LeftBrace) return "{";
        if (kind == TokenKind.RightBrace) return "}";
        if (kind == TokenKind.LeftBracket) return "[";
        if (kind == TokenKind.RightBracket) return "]";
        if (kind == TokenKind.Comma) return ",";
        if (kind == TokenKind.Dot) return ".";
        if (kind == TokenKind.Semicolon) return ";";
        if (kind == TokenKind.Colon) return ":";
        if (kind == TokenKind.Question) return "?";
        if (kind == TokenKind.NullCoalesce) return "??";
        if (kind == TokenKind.EndOfFile) return "EOF";
        if (kind == TokenKind.Error) return "Error";
        return "Unknown";
    }
}
