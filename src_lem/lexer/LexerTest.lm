package lemon.lexer;

class LexerTest {
    public static void main(String[] args) {
        String source = "class Foo extends Bar { int x = 42; void hello() { System.printf(\"hi\"); } }";
        Lexer lexer = new Lexer(source);
        Array<Token> tokens = lexer.tokenize();

        int i = 0;
        while (i < tokens.size()) {
            Token tok = tokens.get(i);
            String posInfo = "L" + tok.span.line + "C" + tok.span.column;
            System.printf("%s: %s\n", posInfo, tok.toString());
            i = i + 1;
        }
        System.printf("Total tokens: %d\n", i);
    }
}
