package lemon.lexer;

class LexerTest {
    public static void main(String[] args) {
        String source = "class Foo extends Bar { int x = 42; void hello() { System.out.println(\"hi\"); } }";
        Lexer lexer = new Lexer(source);
        Array<Token> tokens = lexer.tokenize();

        int i = 0;
        for (Token tok in tokens) {
            String posInfo = "L" + tok.span.line + "C" + tok.span.column;
            System.out.println(posInfo + ": " + tok.toString());
            i = i + 1;
        }
        System.out.println("Total tokens: " + i);
    }
}
