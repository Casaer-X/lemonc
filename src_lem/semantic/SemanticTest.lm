package lemon.semantic;

import lemon.parser.AST;
import lemon.lexer.Lexer;
import lemon.lexer.Token;
import lemon.parser.Parser;

// ============================================================
// Lemon 版语义分析器测试
// 测试策略：对 Lemon 源码进行词法分析 → 语法分析 → 语义分析
// 验证语义分析器能正确检测各类语义错误
// ============================================================

class SemanticTest {
    public static void main(String[] args) {
        int passCount = 0;
        int failCount = 0;

        // Test 1: 正确代码 — 无错误
        System.printf("\n=== Test 1: Valid Code (No Errors) ===\n");
        bool t1 = SemanticTest.testNoErrors("ValidCode",
            "class Foo { int x; void hello() { this.x = 42; } }");
        if (t1) { passCount = passCount + 1; } else { failCount = failCount + 1; }

        // Test 2: 重复定义
        System.printf("\n=== Test 2: Duplicate Definition ===\n");
        bool t2 = SemanticTest.testHasError("DuplicateDef",
            "class Foo { } class Foo { }",
            SemanticErrorKind.DuplicateDefinition);
        if (t2) { passCount = passCount + 1; } else { failCount = failCount + 1; }

        // Test 3: 未定义类
        System.printf("\n=== Test 3: Undefined Class ===\n");
        bool t3 = SemanticTest.testHasError("UndefinedClass",
            "class Foo { void test() { Bar b = new Bar(); } }",
            SemanticErrorKind.UndefinedClass);
        if (t3) { passCount = passCount + 1; } else { failCount = failCount + 1; }

        // Test 4: 未定义变量
        System.printf("\n=== Test 4: Undefined Variable ===\n");
        bool t4 = SemanticTest.testHasError("UndefinedVar",
            "class Foo { void test() { x = 42; } }",
            SemanticErrorKind.UndefinedVariable);
        if (t4) { passCount = passCount + 1; } else { failCount = failCount + 1; }

        // Test 5: 未定义类型
        System.printf("\n=== Test 5: Undefined Type ===\n");
        bool t5 = SemanticTest.testHasError("UndefinedType",
            "class Foo { UnknownType x; }",
            SemanticErrorKind.UndefinedType);
        if (t5) { passCount = passCount + 1; } else { failCount = failCount + 1; }

        // Test 6: 继承 + 接口实现
        System.printf("\n=== Test 6: Inheritance & Interface ===\n");
        bool t6 = SemanticTest.testNoErrors("Inheritance",
            "interface Printable { void print(); } class Base { int x; } class Derived extends Base implements Printable { void print() { System.printf(\"hi\"); } }");
        if (t6) { passCount = passCount + 1; } else { failCount = failCount + 1; }

        // Test 7: 接口方法未实现
        System.printf("\n=== Test 7: Interface Method Not Implemented ===\n");
        bool t7 = SemanticTest.testHasError("InterfaceNotImpl",
            "interface Printable { void print(); } class Foo implements Printable { }",
            SemanticErrorKind.InterfaceMethodNotImplemented);
        if (t7) { passCount = passCount + 1; } else { failCount = failCount + 1; }

        // Test 8: 循环继承
        System.printf("\n=== Test 8: Circular Inheritance ===\n");
        bool t8 = SemanticTest.testHasError("CircularInherit",
            "class A extends B { } class B extends A { }",
            SemanticErrorKind.CircularInheritance);
        if (t8) { passCount = passCount + 1; } else { failCount = failCount + 1; }

        // Test 9: 裸方法调用
        System.printf("\n=== Test 9: Bare Method Call ===\n");
        bool t9 = SemanticTest.testHasError("BareMethodCall",
            "class Foo { void hello() { } void test() { hello(); } }",
            SemanticErrorKind.BareMethodCall);
        if (t9) { passCount = passCount + 1; } else { failCount = failCount + 1; }

        // Test 10: 自语义分析
        System.printf("\n=== Test 10: Self-Semantic Analysis ===\n");
        bool t10 = SemanticTest.selfSemantic("src_lem/lexer/Span.lm") &&
                   SemanticTest.selfSemantic("src_lem/lexer/TokenKind.lm") &&
                   SemanticTest.selfSemantic("src_lem/lexer/Token.lm") &&
                   SemanticTest.selfSemantic("src_lem/lexer/Lexer.lm") &&
                   SemanticTest.selfSemantic("src_lem/lexer/LexerTest.lm") &&
                   SemanticTest.selfSemantic("src_lem/parser/AST.lm") &&
                   SemanticTest.selfSemantic("src_lem/parser/Parser.lm") &&
                   SemanticTest.selfSemantic("src_lem/semantic/SemanticError.lm") &&
                   SemanticTest.selfSemantic("src_lem/semantic/SemanticAnalyzer.lm");
        if (t10) { passCount = passCount + 1; } else { failCount = failCount + 1; }

        // Summary
        System.printf("\n============================\n");
        System.printf("Passed: %d  Failed: %d\n", passCount, failCount);
        if (failCount == 0) {
            System.printf("All tests passed!\n");
        } else {
            System.printf("Some tests FAILED!\n");
        }
    }

    // ---- 测试辅助方法 ----

    static SemanticAnalyzer analyzeSource(String src) {
        Lexer lexer = new Lexer(src);
        Array<Token> tokens = lexer.tokenize();
        Parser parser = new Parser(tokens);
        Program program = parser.parse();
        SemanticAnalyzer analyzer = new SemanticAnalyzer();
        analyzer.analyze(program);
        return analyzer;
    }

    // 测试：期望无语义错误
    static bool testNoErrors(String testName, String src) {
        SemanticAnalyzer analyzer = SemanticTest.analyzeSource(src);
        Array<SemanticError> errors = analyzer.getErrors();
        if (errors.size() == 0) {
            System.printf("  [PASS] %s: no errors\n", testName);
            return true;
        } else {
            System.printf("  [FAIL] %s: expected 0 errors, got %d\n", testName, errors.size());
            for (int i = 0; i < errors.size(); i++) {
                SemanticError err = errors.get(i);
                System.printf("    %s\n", err.toString());
            }
            return false;
        }
    }

    // 测试：期望包含特定类型的语义错误
    static bool testHasError(String testName, String src, int expectedKind) {
        SemanticAnalyzer analyzer = SemanticTest.analyzeSource(src);
        Array<SemanticError> errors = analyzer.getErrors();
        bool found = false;
        for (int i = 0; i < errors.size(); i++) {
            SemanticError err = errors.get(i);
            if (err.kind == expectedKind) {
                found = true;
                break;
            }
        }
        if (found) {
            System.printf("  [PASS] %s: found expected error\n", testName);
            return true;
        } else {
            System.printf("  [FAIL] %s: expected error kind %d, got %d errors\n", testName, expectedKind, errors.size());
            for (int i = 0; i < errors.size(); i++) {
                SemanticError err = errors.get(i);
                System.printf("    %s\n", err.toString());
            }
            return false;
        }
    }

    // 自语义分析：对 .lm 源文件进行完整的语义分析
    static bool selfSemantic(String path) {
        String src = File.readAll(path);
        if (src == null) {
            System.printf("  %s: file not found\n", path);
            return false;
        }
        SemanticAnalyzer analyzer = SemanticTest.analyzeSource(src);
        Array<SemanticError> errors = analyzer.getErrors();
        Array<String> warnings = analyzer.getWarnings();
        System.printf("  %s: %d errors, %d warnings\n", path, errors.size(), warnings.size());
        int limit = errors.size();
        if (limit > 5) { limit = 5; }
        for (int i = 0; i < limit; i++) {
            SemanticError err = errors.get(i);
            System.printf("    ERROR: %s\n", err.toString());
        }
        // 自语义分析允许有错误（因为语义分析器可能还不完整）
        return true;
    }
}
