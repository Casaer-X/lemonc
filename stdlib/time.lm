// @compile target=library
// Lemon Standard Library - Time Module

package time;

public class Time {
    public static final int CLOCKS_PER_SEC = 1000;

    public static int ticks() {
        return System.clock();
    }

    public static int nowSeconds() {
        return System.time(0);
    }

    public static double elapsedSeconds(int startTicks) {
        int current = System.clock();
        return (double)(current - startTicks) / 1000.0;
    }

    public static int elapsedMillis(int startTicks) {
        return System.clock() - startTicks;
    }
}

public class Timer {
    private int startTicks;
    private int stopTicks;
    private bool running;

    public Timer() {
        this.startTicks = 0;
        this.stopTicks = 0;
        this.running = false;
    }

    public void start() {
        this.startTicks = System.clock();
        this.stopTicks = this.startTicks;
        this.running = true;
    }

    public void stop() {
        this.stopTicks = System.clock();
        this.running = false;
    }

    public void reset() {
        this.startTicks = System.clock();
        this.stopTicks = this.startTicks;
    }

    public bool isRunning() {
        return this.running;
    }

    public int elapsedMillis() {
        if (this.running) {
            return System.clock() - this.startTicks;
        }
        return this.stopTicks - this.startTicks;
    }

    public double elapsedSeconds() {
        return (double)this.elapsedMillis() / 1000.0;
    }
}
