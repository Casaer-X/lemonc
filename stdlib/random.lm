// @compile target=library
// Lemon Standard Library - Random Module

package random;

public class Random {
    private int seed;

    public Random() {
        this.seed = System.clock();
        if (this.seed == 0) {
            this.seed = 12345;
        }
    }

    public Random(int seed) {
        this.seed = seed;
    }

    public void setSeed(int seed) {
        this.seed = seed;
    }

    public int getSeed() {
        return this.seed;
    }

    public int nextInt() {
        this.seed = this.seed * 1103515245 + 12345;
        this.seed = this.seed % 2147483647;
        if (this.seed < 0) {
            this.seed = -this.seed;
        }
        return this.seed;
    }

    public int nextBoundedInt(int bound) {
        if (bound <= 0) return 0;
        return this.nextInt() % bound;
    }

    public int nextIntBetween(int min, int max) {
        if (min >= max) return min;
        return min + this.nextBoundedInt(max - min);
    }

    public double nextDouble() {
        return (double)this.nextInt() / 2147483647.0;
    }

    public double nextDoubleBetween(double min, double max) {
        if (min >= max) return min;
        return min + this.nextDouble() * (max - min);
    }

    public bool nextBool() {
        return this.nextInt() % 2 == 1;
    }
}

public class RandomUtils {
    public static void seed(int seed) {
        System.srand(seed);
    }

    public static int randomInt() {
        int value = System.rand();
        if (value < 0) return -value;
        return value;
    }

    public static int randomIntBounded(int bound) {
        if (bound <= 0) return 0;
        return RandomUtils.randomInt() % bound;
    }

    public static int randomIntBetween(int min, int max) {
        if (min >= max) return min;
        return min + RandomUtils.randomIntBounded(max - min);
    }

    public static double randomDouble() {
        return (double)RandomUtils.randomInt() / 2147483647.0;
    }

    public static double randomDoubleBetween(double min, double max) {
        if (min >= max) return min;
        return min + RandomUtils.randomDouble() * (max - min);
    }

    public static bool randomBool() {
        return RandomUtils.randomInt() % 2 == 1;
    }
}
