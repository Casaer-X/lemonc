// @compile target=library
// Lemon Standard Library - Random Module

package random;

public class Random {
    private int seed;

    public Random() {
        this.seed = 12345;
    }

    public Random(int seed) {
        this.seed = seed;
    }

    public int nextInt() {
        this.seed = this.seed * 1103515245 + 12345;
        this.seed = this.seed % 2147483647;
        if (this.seed < 0) this.seed = -this.seed;
        return this.seed;
    }

    public int nextInt(int bound) {
        if (bound <= 0) return 0;
        return this.nextInt() % bound;
    }

    public int nextInt(int min, int max) {
        if (min >= max) return min;
        int range = max - min;
        return min + this.nextInt() % range;
    }

    public double nextDouble() {
        return (double)this.nextInt() / 2147483647.0;
    }

    public double nextDouble(double min, double max) {
        if (min >= max) return min;
        double range = max - min;
        return min + this.nextDouble() * range;
    }

    public bool nextBool() {
        return this.nextInt() % 2 == 1;
    }

    public void setSeed(int seed) {
        this.seed = seed;
    }

    public int getSeed() {
        return this.seed;
    }
}

public class RandomUtils {
    private static Random defaultRandom = new Random();

    public static int randomInt(int bound) {
        return defaultRandom.nextInt(bound);
    }

    public static int randomInt(int min, int max) {
        return defaultRandom.nextInt(min, max);
    }

    public static double randomDouble() {
        return defaultRandom.nextDouble();
    }

    public static double randomDouble(double min, double max) {
        return defaultRandom.nextDouble(min, max);
    }

    public static bool randomBool() {
        return defaultRandom.nextBool();
    }

    public static int randomChoice(int a, int b) {
        if (RandomUtils.randomBool()) return a;
        return b;
    }
}