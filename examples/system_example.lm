// @compile target=exe
// Lemon 示例 - 系统与断言

package examples;

public class SystemExample {
    public static void main(String[] args) {
        System.printf("=== 系统与断言示例 ===\n\n");

        // 1. 基本断言
        System.printf("1. 基本断言:\n");
        System.printf("   测试 1 + 1 == 2...\n");
        SystemExample.assertTrue(1 + 1 == 2);
        System.printf("   通过!\n");
        System.printf("   测试 10 > 5...\n");
        SystemExample.assertTrue(10 > 5);
        System.printf("   通过!\n");

        // 2. 相等断言
        System.printf("\n2. 相等断言:\n");
        System.printf("   测试 42 == 42...\n");
        SystemExample.assertEquals(42, 42);
        System.printf("   通过!\n");

        // 3. 数学计算断言
        System.printf("\n3. 数学计算断言:\n");
        int result = 5 * 5;
        System.printf("   测试 5 * 5 == 25...\n");
        SystemExample.assertEquals(result, 25);
        System.printf("   通过!\n");

        int fact = SystemExample.factorial(5);
        System.printf("   测试 factorial(5) == 120...\n");
        SystemExample.assertEquals(fact, 120);
        System.printf("   通过!\n");

        // 4. 数组操作断言
        System.printf("\n4. 数组操作断言:\n");
        Array<int> arr = new Array();
        arr.add(1);
        arr.add(2);
        arr.add(3);
        int sum = SystemExample.sumArray(arr);
        System.printf("   测试 sum([1,2,3]) == 6...\n");
        SystemExample.assertEquals(sum, 6);
        System.printf("   通过!\n");

        int maxVal = SystemExample.maxArray(arr);
        System.printf("   测试 max([1,2,3]) == 3...\n");
        SystemExample.assertEquals(maxVal, 3);
        System.printf("   通过!\n");

        // 5. 排序断言
        System.printf("\n5. 排序断言:\n");
        Array<int> unsorted = new Array();
        unsorted.add(3);
        unsorted.add(1);
        unsorted.add(2);
        SystemExample.bubbleSort(unsorted);
        System.printf("   测试排序后 [3,1,2] -> [1,2,3]...\n");
        SystemExample.assertEquals(unsorted.get(0), 1);
        SystemExample.assertEquals(unsorted.get(1), 2);
        SystemExample.assertEquals(unsorted.get(2), 3);
        System.printf("   通过!\n");

        // 6. 综合测试
        System.printf("\n6. 综合测试:\n");
        SystemExample.testMathFunctions();
        SystemExample.testArrayFunctions();

        System.printf("\n7. 系统信息:\n");
        System.printf("   程序正常执行中...\n");
        System.printf("   所有测试通过!\n");

        System.printf("\n=== 示例结束 ===\n");
    }

    public static void assertTrue(bool condition) {
        if (!condition) {
            System.printf("   ASSERTION FAILED!\n");
        }
    }

    public static void assertEquals(int expected, int actual) {
        if (expected != actual) {
            System.printf("   ASSERTION FAILED: expected %d, got %d\n", expected, actual);
        }
    }

    public static int factorial(int n) {
        if (n <= 1) return 1;
        return n * SystemExample.factorial(n - 1);
    }

    public static int sumArray(Array<int> arr) {
        int total = 0;
        int n = arr.size();
        for (int i = 0; i < n; i++) {
            total = total + arr.get(i);
        }
        return total;
    }

    public static int maxArray(Array<int> arr) {
        int n = arr.size();
        if (n == 0) return 0;
        int maxVal = arr.get(0);
        for (int i = 1; i < n; i++) {
            int val = arr.get(i);
            if (val > maxVal) {
                maxVal = val;
            }
        }
        return maxVal;
    }

    public static void bubbleSort(Array<int> arr) {
        int n = arr.size();
        for (int i = 0; i < n - 1; i++) {
            for (int j = 0; j < n - i - 1; j++) {
                if (arr.get(j) > arr.get(j + 1)) {
                    int temp = arr.get(j);
                    arr.set(j, arr.get(j + 1));
                    arr.set(j + 1, temp);
                }
            }
        }
    }

    public static int linearSearch(Array<int> arr, int target) {
        int n = arr.size();
        for (int i = 0; i < n; i++) {
            if (arr.get(i) == target) {
                return i;
            }
        }
        return -1;
    }

    public static void testMathFunctions() {
        System.printf("   测试数学函数...\n");
        SystemExample.assertEquals(SystemExample.factorial(0), 1);
        SystemExample.assertEquals(SystemExample.factorial(1), 1);
        SystemExample.assertEquals(SystemExample.factorial(5), 120);
        SystemExample.assertEquals(SystemExample.powInt(2, 10), 1024);
        SystemExample.assertEquals(SystemExample.gcd(48, 18), 6);
        SystemExample.assertEquals(SystemExample.lcm(4, 6), 12);
        System.printf("   数学函数测试通过!\n");
    }

    public static void testArrayFunctions() {
        System.printf("   测试数组函数...\n");
        Array<int> arr = new Array();
        arr.add(1);
        arr.add(2);
        arr.add(3);
        arr.add(4);
        arr.add(5);
        SystemExample.assertEquals(SystemExample.sumArray(arr), 15);
        SystemExample.assertEquals(SystemExample.maxArray(arr), 5);
        SystemExample.reverseArray(arr);
        SystemExample.assertEquals(arr.get(0), 5);
        SystemExample.assertEquals(arr.get(4), 1);
        System.printf("   数组函数测试通过!\n");
    }

    public static int powInt(int base, int exp) {
        if (exp == 0) return 1;
        int result = 1;
        for (int i = 0; i < exp; i++) {
            result = result * base;
        }
        return result;
    }

    public static int gcd(int a, int b) {
        a = SystemExample.abs(a);
        b = SystemExample.abs(b);
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }

    public static int lcm(int a, int b) {
        if (a == 0 || b == 0) return 0;
        return SystemExample.abs(a * b) / SystemExample.gcd(a, b);
    }

    public static int abs(int x) {
        if (x < 0) return -x;
        return x;
    }

    public static void reverseArray(Array<int> arr) {
        int left = 0;
        int right = arr.size() - 1;
        while (left < right) {
            int temp = arr.get(left);
            arr.set(left, arr.get(right));
            arr.set(right, temp);
            left = left + 1;
            right = right - 1;
        }
    }
}