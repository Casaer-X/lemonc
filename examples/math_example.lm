// @compile target=exe
// Lemon 示例 - 数学运算

package examples;

public class MathExample {
    public static void main(String[] args) {
        System.printf("=== 数学运算示例 ===\n\n");

        // 1. 基本算术
        System.printf("1. 基本算术:\n");
        int a = 15;
        int b = 4;
        System.printf("   %d + %d = %d\n", a, b, a + b);
        System.printf("   %d - %d = %d\n", a, b, a - b);
        System.printf("   %d * %d = %d\n", a, b, a * b);
        System.printf("   %d / %d = %d\n", a, b, a / b);
        System.printf("   %d %% %d = %d\n\n", a, b, a % b);

        // 2. 绝对值
        System.printf("2. 绝对值:\n");
        System.printf("   abs(-42) = %d\n", MathExample.abs(-42));
        System.printf("   abs(100) = %d\n\n", MathExample.abs(100));

        // 3. 最大值和最小值
        System.printf("3. 最大值和最小值:\n");
        System.printf("   max(10, 20) = %d\n", MathExample.max(10, 20));
        System.printf("   min(10, 20) = %d\n\n", MathExample.min(10, 20));

        // 4. 阶乘
        System.printf("4. 阶乘:\n");
        int i = 0;
        while (i <= 10) {
            System.printf("   %d! = %d\n", i, MathExample.factorial(i));
            i = i + 1;
        }
        System.printf("\n");

        // 5. 幂运算
        System.printf("5. 幂运算:\n");
        System.printf("   2^10 = %d\n", MathExample.powInt(2, 10));
        System.printf("   3^5 = %d\n", MathExample.powInt(3, 5));
        System.printf("   5^0 = %d\n\n", MathExample.powInt(5, 0));

        // 6. 最大公约数
        System.printf("6. 最大公约数:\n");
        System.printf("   gcd(48, 18) = %d\n", MathExample.gcd(48, 18));
        System.printf("   gcd(100, 35) = %d\n\n", MathExample.gcd(100, 35));

        // 7. 斐波那契数列
        System.printf("7. 斐波那契数列:\n");
        System.printf("   ");
        int j = 0;
        while (j <= 15) {
            System.printf("%d ", MathExample.fibonacci(j));
            j = j + 1;
        }
        System.printf("\n\n");

        // 8. 素数判断
        System.printf("8. 素数判断:\n");
        int k = 2;
        while (k <= 30) {
            if (MathExample.isPrime(k)) {
                System.printf("   %d 是素数\n", k);
            }
            k = k + 1;
        }
        System.printf("\n");

        System.printf("=== 示例结束 ===\n");
    }

    public static int abs(int x) {
        if (x < 0) return -x;
        return x;
    }

    public static int max(int a, int b) {
        if (a > b) return a;
        return b;
    }

    public static int min(int a, int b) {
        if (a < b) return a;
        return b;
    }

    public static int factorial(int n) {
        if (n <= 1) return 1;
        return n * MathExample.factorial(n - 1);
    }

    public static int powInt(int base, int exp) {
        if (exp == 0) return 1;
        int result = 1;
        int m = 0;
        while (m < exp) {
            result = result * base;
            m = m + 1;
        }
        return result;
    }

    public static int gcd(int a, int b) {
        a = MathExample.abs(a);
        b = MathExample.abs(b);
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }

    public static int fibonacci(int n) {
        if (n <= 0) return 0;
        if (n == 1) return 1;
        int fa = 0;
        int fb = 1;
        int idx = 2;
        while (idx <= n) {
            int temp = fa + fb;
            fa = fb;
            fb = temp;
            idx = idx + 1;
        }
        return fb;
    }

    public static bool isPrime(int n) {
        if (n < 2) return false;
        if (n == 2) return true;
        if (n % 2 == 0) return false;
        int d = 3;
        while (d * d <= n) {
            if (n % d == 0) return false;
            d = d + 2;
        }
        return true;
    }
}